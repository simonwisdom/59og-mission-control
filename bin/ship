#!/bin/bash
# Ship this worktree's branch: check it, put it on main on GitHub, which Railway deploys
# (the-olive-grove.up.railway.app). Run from a session's own worktree, after Simon says ship:
#   bin/ship           ship it
#   bin/ship --check   everything up to the push (setup, rebase, lint, tests, build), then stop
# The common steps (refusals, lock, rebase, push, cleanup) are the shared ship in ~/.local/bin,
# from ~/Documents/2026/skills/global/bin/ship; this file holds what is mission control's own.
# The shared ship also refuses when the checks change tracked files (next build/dev re-add their
# agent notes to CLAUDE.md; anything they leave behind would ship unseen).

SITE="${SHIP_SITE-https://the-olive-grove.up.railway.app}"

ship_prepare() {
  "$HERE/bin/setup" || die "setup failed (above); main hasn't moved"
}

ship_test() {
  echo "ship: running the linter"
  npm run -s lint || die "lint fails after rebasing onto main (above); main hasn't moved"
  echo "ship: running the tests"
  npm test -s || die "tests fail after rebasing onto main (above); main hasn't moved"
  echo "ship: building"
  npm run -s build >/dev/null || die "the build fails after rebasing onto main (run 'npm run build' to see why); main hasn't moved"
}

# Railway builds for a few minutes after the push; until then the old version keeps answering.
# Only GETs pages that need no login, so nothing is saved.
ship_verify() {
  local path code
  for path in / /login; do
    code="$(curl -s -o /dev/null -m 20 -w '%{http_code}' "$SITE$path" || true)"
    case "$code" in 2*|3*) ;; *) echo "ship: $SITE$path answered '$code'; see the Railway dashboard (olive-grove, web)" >&2 ;; esac
  done
  NOTE="and Railway deploys it in a few minutes"
}

source "$HOME/.local/bin/ship"
