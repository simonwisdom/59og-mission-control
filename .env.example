DATABASE_URL=postgres://localhost:5432/mission_control
# Shared password housemates use to log in. Make it long and random.
HOUSE_PASSWORD=
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=
# Optional: smart meter usage on the Energy page. Both are on the Octopus
# website under Personal details > API access. The account number looks like A-1234ABCD.
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT_NUMBER=
# Set to kWh only if the gas meter is an older SMETS1 one; newer meters report m³.
OCTOPUS_GAS_UNIT=
# Optional: the house account on the House money page, from Actual Budget. The server's address
# (e.g. https://actual.example.com), its login password, and the budget's sync ID (in Actual under
# Settings > Show advanced settings). The encryption password only if end-to-end encryption is on.
# ACTUAL_ACCOUNTS is a comma-separated list of account names to show; leave empty for every open one.
ACTUAL_SERVER_URL=
ACTUAL_PASSWORD=
ACTUAL_SYNC_ID=
ACTUAL_ENCRYPTION_PASSWORD=
ACTUAL_ACCOUNTS=
# Optional: bin collection days on the dashboard. The house's property id in Hackney's
# bin collection system; src/lib/hackney-bins.ts says how to look one up.
HACKNEY_BIN_PROPERTY_ID=
# Optional: push a notification to housemates' phones for each new application, via the
# ntfy app (https://ntfy.sh). Anyone who knows the topic can read it, so make it long and
# random, e.g. olive-grove-$(openssl rand -hex 8). APP_URL makes the notification open the application.
NTFY_TOPIC=
APP_URL=
# Optional: turns on /api/bot/summary, the read-only feed for Grovelet, the house chat bot. The bot
# sends it as a bearer token. Make it long and random, e.g. `openssl rand -base64 48`.
BOT_API_TOKEN=
